{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"files": {
		"includes": [
			"**",
			"**/*.blade.php",
			"!**/node_modules",
			"!**/vendor",
			"!**/public",
			"!**/storage",
			"!**/.serena",
			"!**/.claude",
			"!**/.superpowers",
			"!**/*.{yaml,yml,toml,neon,xml,md,cache}",
			"!**/tests/cypress/support"
		]
	}
}
