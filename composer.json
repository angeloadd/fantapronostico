{
	"name": "laravel/laravel",
	"type": "project",
	"description": "The skeleton application for the Laravel framework.",
	"keywords": ["laravel", "framework"],
	"license": "MIT",
	"require": {
		"php": "^8.5",
		"filament/filament": "^4.11",
		"irazasyed/telegram-bot-sdk": "^3.16",
		"laravel/fortify": "^1.37",
		"laravel/framework": "^13.11",
		"laravel/tinker": "^3.0",
		"resend/resend-laravel": "^1.4"
	},
	"require-dev": {
		"barryvdh/laravel-ide-helper": "^3.7",
		"fakerphp/faker": "^1.24",
		"larastan/larastan": "^3.9",
		"laravel/pint": "^1.29",
		"laravel/sail": "^1.60",
		"mockery/mockery": "^1.6",
		"nunomaduro/collision": "^8.9",
		"phpunit/phpunit": "^13.0",
		"roave/security-advisories": "dev-latest",
		"spatie/laravel-ignition": "^2.12"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/",
			"Database\\Factories\\": "database/factories/",
			"Database\\Seeders\\": "database/seeders/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "vendor/bin/phpunit --testdox",
		"test:feature": "@test --testsuite Feature",
		"test:unit": "@test --testsuite Unit",
		"test:filter": "@test --filter",
		"test:coverage": "XDEBUG_MODE=coverage @test --coverage",
		"check": "vendor/bin/pint --test",
		"fix": "vendor/bin/pint",
		"stan": "vendor/bin/phpstan analyse --memory-limit 1G",
		"post-autoload-dump": [
			"Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
			"@php artisan package:discover --ansi",
			"@php artisan filament:upgrade"
		],
		"post-update-cmd": [
			"@php artisan vendor:publish --tag=laravel-assets --ansi --force"
		],
		"post-root-package-install": [
			"@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
		],
		"post-create-project-cmd": [
			"@php artisan key:generate --ansi",
			"@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
			"@php artisan migrate --ansi"
		],
		"ide-helper:all": [
			"@php artisan ide-helper:generate",
			"@php artisan ide-helper:eloquent",
			"@php artisan ide-helper:meta",
			"@php artisan ide-helper:models --write",
			"@fix"
		],
		"deploy": [
			"git pull",
			"composer install --no-dev --optimize-autoloader -q",
			"php artisan migrate --force",
			"php artisan optimize",
			"pnpm install --frozen-lockfile",
			"pnpm rebuild @biomejs/biome esbuild sass",
			"pnpm run build",
			"chown -R www-data:www-data storage/ bootstrap/cache/"
		]
	},
	"extra": {
		"branch-alias": {
			"dev-master": "13.x-dev"
		},
		"laravel": {
			"dont-discover": []
		}
	},
	"config": {
		"optimize-autoloader": true,
		"preferred-install": "dist",
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true,
			"php-http/discovery": true
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true
}
